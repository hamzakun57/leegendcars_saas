# -----------------------------------------------------------------------------
# Leegend Cars — variables d'environnement
# Copie ce fichier en « .env » (il est ignoré par Git, ne jamais le versionner).
# -----------------------------------------------------------------------------

# --- Base de données Supabase ----------------------------------------------
# Variables pour le mode Express mono-agence historique uniquement.
# Pour le SaaS, utiliser exclusivement les variables SAAS_* ci-dessous.
# Supabase > Project Settings > Database > Connection string > URI
# Choisis le mode « Session pooler » (port 5432) : il fonctionne en IPv4.
DATABASE_URL=postgresql://postgres.XXXXXXXXXXXX:MOT_DE_PASSE@aws-0-REGION.pooler.supabase.com:5432/postgres

# --- SaaS : nouveau projet Supabase, jamais celui de l'agence --------------
# Définir ces variables dans le .env de la copie SaaS uniquement.
# SAAS_PROJECT_REF=nouveau-project-ref
# SAAS_DATABASE_URL=postgresql://postgres.nouveau-project-ref:mot_de_passe@aws-0-region.pooler.supabase.com:5432/postgres
# SAAS_SUPABASE_URL=https://nouveau-project-ref.supabase.co
# SAAS_SUPABASE_ANON_KEY=cle-publique-du-nouveau-projet
# SAAS_SUPABASE_SERVICE_ROLE_KEY=cle-service-du-nouveau-projet
# SAAS_DATA_SOURCE=supabase
# SAAS_AGENCY_SLUG=slug-de-l-agence (facultatif; sinon ?agency=slug)

# --- Supabase Storage (photos véhicules + pièces jointes) ------------------
# Variables du mode Express mono-agence historique uniquement.
# Supabase > Project Settings > API
SUPABASE_URL=https://XXXXXXXXXXXX.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# --- Session administrateur -------------------------------------------------
# Secret de signature des cookies. Génère-le une seule fois avec :
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=colle_ici_un_texte_aleatoire_de_64_caracteres

# --- Divers ----------------------------------------------------------------
# NODE_ENV=production
# PORT=3000

# Flotte de démonstration : 1 = importe 3 voitures au premier démarrage si la
# base est vide. 0 = laisse le parc vide, à remplir dans l'admin.
#SEED_FLEET=0