# Dépendances installées par npm
node_modules/

# -----------------------------------------------------------------------------
# Données de l'application — NE JAMAIS versionner.
# L'ancienne base SQLite et le dossier uploads/ contiennent les données des
# clients (noms, CIN, passeports) et les pièces jointes. Tout est désormais
# dans Supabase ; ces dossiers ne servent plus que hors production.
server/data/
uploads/

# Secrets d'environnement
.env
.env.*
!.env.example

# Modèles de contrat fournis : documents officiels contenant des données
# personnelles réelles. À conserver hors dépôt.
model_contrat.pdf
NEW_MODEL.pdf

# Fichiers de travail personnels
info_*.txt
*.jfif

# Systèmes et éditeurs
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp

# Journaux
*.log
npm-debug.log*

# -----------------------------------------------------------------------------
# Fichiers produits par « npm run build ».
# Les pages d'administration sont générées depuis server/views.js et le client
# Supabase est copié depuis node_modules : les garder hors du dépôt évite deux
# versions de la même page. Le build Netlify les régénère à chaque déploiement.
# -----------------------------------------------------------------------------
admin/index.html
admin/login.html
admin-assets/
doc-assets/
vendor/
runtime-config.js

Contrat*.pdf
Signature*.pdf
contrat_page1.PNG
